# upstream: none Official Redis library image that Orbit uses for its realtime bus and rate limits, not the Orbit app
FROM redis:8-alpine@sha256:978f0e01593e65eed801f2402944efcd936d43b5027e4908a7897baf88ed6241

ENV ORBIT_ROLE=redis
COPY --chmod=755 railway-boot.sh /usr/local/bin/railway-boot.sh
ENTRYPOINT ["/bin/sh", "/usr/local/bin/railway-boot.sh"]
